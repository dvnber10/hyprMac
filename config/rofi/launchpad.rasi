configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "WhiteSur";
    display-drun: "";
    drun-display-format: "{name}";
    font: "sans-serif 11";
    
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

* {
    bg-base:     rgba(30, 30, 30, 0.75);
    bg-alt:      rgba(255, 255, 255, 0.08);
    bg-selected: rgba(255, 255, 255, 0.18);
    fg-main:     #f3f3f3;
    fg-muted:    #a0a0a0;
    accent:      #0a84ff;

    background-color: transparent;
    text-color: @fg-main;
}

window {
    transparency: "real";
    /* Desactivamos la pantalla completa */
    fullscreen: false;
    /* Definimos un tamaño fijo para la ventana flotante */
    width: 700px;
    height: 550px;
    
    background-color: @bg-base;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 30px;
}

mainbox {
    spacing: 25px;
    children: [ message, inputbar, listview ];
}

/* Pequeño título superior estilo "Applications" */
message {
    background-color: transparent;
    margin: 0px;
    padding: 0px;
}

textbox {
    text-color: @fg-muted;
    horizontal-alignment: 0.5;
    font: "sans-serif bold 12";
    content: "Applications";
}

inputbar {
    background-color: @bg-alt;
    margin: 0px 180px;
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    children: [ prompt, entry ];
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search";
    placeholder-color: @fg-muted;
    text-color: @fg-main;
    horizontal-alignment: 0.5;
}

listview {
    columns: 6;
    lines: 4;
    cycle: true;
    dynamic: true;
    layout: vertical;
    spacing: 15px;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 10px 5px;
    border-radius: 14px;
    background-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

element-icon {
    size: 72px;
    horizontal-alignment: 0.5;
    vertical-alignment: 0.5;
    margin: 0px 0px 8px 0px;
}

element-text {
    horizontal-alignment: 0.5;
    vertical-alignment: 0.5;
    font: "sans-serif 10";
}