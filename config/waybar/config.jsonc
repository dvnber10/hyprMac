{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "modules-left": [
        "custom/apple",
        "custom/minimized",
        "custom/app-name"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "custom/wifi",
        "custom/bluetooth",
        "battery",
        "custom/control-center"
    ],

    /* --- Módulos específicos --- */
    "custom/apple": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/eww/scripts/toogle_apple_menu.sh"
    },
    "custom/minimized": {
        "exec": "~/.config/waybar/minimized_apps.sh",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "format": "{}",
        "max-length": 32,
        "tooltip": true,
        "on-click": "~/.config/waybar/minimized_apps.sh --restore"
    },
    "custom/app-name": {
        "exec": "~/.config/waybar/app_name.sh",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "~/.config/eww/scripts/toggle_calendar.sh"
        
    },
    "custom/wifi": {
        "exec": "~/.config/waybar/wifi_icon.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "on-click": "~/.config/eww/scripts/toogle_control_center.sh wifi-menu",
        "on-click-right": "~/.config/eww/scripts/toogle_control_center.sh wifi-menu"
    },
    "custom/bluetooth": {
        "exec": "~/.config/waybar/bluetooth_icon.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "on-click": "~/.config/eww/scripts/toogle_control_center.sh bluetooth-menu",
        "on-click-right": "~/.config/eww/scripts/toogle_control_center.sh bluetooth-menu"
    },
    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": "󰖁",
        "on-click": "~/.config/eww/scripts/toogle_control_center.sh audio-menu",
        "on-click-right": "~/.config/eww/scripts/toogle_control_center.sh audio-menu"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-icons": ["", "", "", "", ""],
        "on-click": "~/.config/eww/scripts/toogle_control_center.sh battery-menu",
        "on-click-right": "~/.config/eww/scripts/toogle_control_center.sh battery-menu"
    },
    "custom/control-center": {
        "format": "    ",
        "tooltip": false,
        "on-click": "~/.config/eww/scripts/toogle_control_center.sh control-center"
    }
}
