;; Menu dinamico: DBusMenu nativo con fallback por aplicacion.

(defvar active_menu "Archivo")
(defpoll global_menu :interval "1s" :initial "[]"
  "~/.config/eww/scripts/dbusmenu_bridge.py --menu-from-eww")

(defwidget global-menu-item [item]
  (button :class "menu-item"
          :onclick {"~/.config/eww/scripts/dbusmenu_action.py --id " + item.id + " --service '" + item.service + "' --path '" + item.path + "' --command '" + item.command + "'"}
    (box :orientation "horizontal" :halign "fill"
      (label :hexpand true :halign "start" :text {item.label})
      (label :class "menu-item-shortcut" :halign "end" :text ""))))

(defwidget global-menu-content []
  (box :class "menu-dropdown-box" :orientation "vertical"
    (for item in global_menu
      (global-menu-item :item item))))

(defwindow menu-global-archivo
  :monitor 0 :geometry (geometry :x "65px" :y "30px" :width "280px" :anchor "top left")
  :stacking "foreground" :focusable false :exclusive false :class "menu-dropdown"
  (global-menu-content))

