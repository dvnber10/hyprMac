;; Menú Terminal
(defwindow menu-terminal
  :monitor 0
  :geometry (geometry :x "320px" :y "30px" :width "240px" :anchor "top left")
  :stacking "foreground"
  :focusable false
  :exclusive false
  :class "menu-dropdown"
  (box :class "menu-dropdown-box" :orientation "vertical"
    (button :class "menu-item" :onclick "wtype -M ctrl shift c; ~/.config/eww/scripts/close_popups.sh"
      (box :orientation "horizontal" :halign "fill"
        (label :hexpand true :halign "start" :text "Copiar")
        (label :class "menu-item-shortcut" :halign "end" :text "⇧⌘C")))
    (button :class "menu-item" :onclick "wtype -M ctrl shift v; ~/.config/eww/scripts/close_popups.sh"
      (box :orientation "horizontal" :halign "fill"
        (label :hexpand true :halign "start" :text "Pegar")
        (label :class "menu-item-shortcut" :halign "end" :text "⇧⌘V")))
    (box :orientation "horizontal" :class "menu-separator" "")
    (button :class "menu-item" :onclick "wtype -M ctrl shift f; ~/.config/eww/scripts/close_popups.sh"
      (box :orientation "horizontal" :halign "fill"
        (label :hexpand true :halign "start" :text "Buscar en terminal")
        (label :class "menu-item-shortcut" :halign "end" :text "⇧⌘F")))))
