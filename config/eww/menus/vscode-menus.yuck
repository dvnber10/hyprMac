;; Acciones de Visual Studio Code.
;; Estas widgets se usan desde cada menu para mantenerlos separados.

(defwidget vscode-archivo []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "New Text File" :shortcut "Ctrl+N" :command "wtype -M ctrl n; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "New File..." :shortcut "Ctrl+Alt+N" :command "wtype -M ctrl alt n; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "New Window" :shortcut "Ctrl+Shift+N" :command "wtype -M ctrl shift n; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "New Window with Profile" :shortcut "" :command "wtype -M ctrl shift n; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Open File..." :shortcut "Ctrl+O" :command "wtype -M ctrl o; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Open Folder..." :shortcut "Ctrl+K Ctrl+O" :command "wtype -M ctrl k; wtype -M ctrl o; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Open Workspace from File..." :shortcut "" :command "wtype -M ctrl k; wtype -M ctrl o; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Open Recent" :shortcut "Ctrl+R" :command "wtype -M ctrl r; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Add Folder to Workspace..." :shortcut "" :command "wtype -M ctrl k; wtype -M ctrl f; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Save" :shortcut "Ctrl+S" :command "wtype -M ctrl s; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Save As..." :shortcut "Ctrl+Shift+S" :command "wtype -M ctrl shift s; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Save All" :shortcut "Ctrl+K S" :command "wtype -M ctrl k; wtype -M s; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Revert File" :shortcut "" :command "wtype -M ctrl k; wtype -M r; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Close Editor" :shortcut "Ctrl+F4" :command "wtype -M ctrl f4; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Close Folder" :shortcut "" :command "wtype -M ctrl k; wtype -M f; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Exit" :shortcut "Ctrl+Q" :command "wtype -M ctrl q; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-edicion []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "Undo" :shortcut "Ctrl+Z" :command "wtype -M ctrl z; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Redo" :shortcut "Ctrl+Y" :command "wtype -M ctrl y; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Cut" :shortcut "Ctrl+X" :command "wtype -M ctrl x; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Copy" :shortcut "Ctrl+C" :command "wtype -M ctrl c; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Paste" :shortcut "Ctrl+V" :command "wtype -M ctrl v; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Find" :shortcut "Ctrl+F" :command "wtype -M ctrl f; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Replace" :shortcut "Ctrl+H" :command "wtype -M ctrl h; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Find in Files" :shortcut "Ctrl+Shift+F" :command "wtype -M ctrl shift f; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Toggle Line Comment" :shortcut "Ctrl+/" :command "wtype -M ctrl slash; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Format Document" :shortcut "Shift+Alt+F" :command "wtype -M ctrl shift i; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Rename Symbol" :shortcut "F2" :command "wtype -M f2; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-seleccion []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "Select All" :shortcut "Ctrl+A" :command "wtype -M ctrl a; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Expand Selection" :shortcut "Shift+Alt+Right" :command "wtype -M ctrl shift right; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Shrink Selection" :shortcut "Shift+Alt+Left" :command "wtype -M ctrl shift left; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Copy Line Up" :shortcut "Shift+Alt+Up" :command "wtype -M ctrl shift up; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Copy Line Down" :shortcut "Shift+Alt+Down" :command "wtype -M ctrl shift down; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Move Line Up" :shortcut "Alt+Up" :command "wtype -M alt up; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Move Line Down" :shortcut "Alt+Down" :command "wtype -M alt down; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Add Cursor Above" :shortcut "Ctrl+Alt+Up" :command "wtype -M ctrl alt up; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Add Cursor Below" :shortcut "Ctrl+Alt+Down" :command "wtype -M ctrl alt down; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-ver []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "Command Palette..." :shortcut "Ctrl+Shift+P" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Open View..." :shortcut "Ctrl+Q" :command "wtype -M ctrl q; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Appearance" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Editor Layout" :shortcut "" :command "wtype -M ctrl alt 0; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Zoom In" :shortcut "Ctrl+=" :command "wtype -M ctrl equal; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Zoom Out" :shortcut "Ctrl+-" :command "wtype -M ctrl minus; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Reset Zoom" :shortcut "Ctrl+0" :command "wtype -M ctrl 0; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Explorer" :shortcut "Ctrl+Shift+E" :command "wtype -M ctrl shift e; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Search" :shortcut "Ctrl+Shift+F" :command "wtype -M ctrl shift f; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Source Control" :shortcut "Ctrl+Shift+G" :command "wtype -M ctrl shift g; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Extensions" :shortcut "Ctrl+Shift+X" :command "wtype -M ctrl shift x; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-ir []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "Go to File..." :shortcut "Ctrl+P" :command "wtype -M ctrl p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Go to Symbol in Editor..." :shortcut "Ctrl+Shift+O" :command "wtype -M ctrl shift o; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Go to Symbol in Workspace..." :shortcut "Ctrl+T" :command "wtype -M ctrl t; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Go to Definition" :shortcut "F12" :command "wtype -M f12; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Go to Declaration" :shortcut "Ctrl+F12" :command "wtype -M ctrl f12; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Go Back" :shortcut "Alt+Left" :command "wtype -M alt left; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Go Forward" :shortcut "Alt+Right" :command "wtype -M alt right; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Go to Line/Column..." :shortcut "Ctrl+G" :command "wtype -M ctrl g; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-run []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "Start Debugging" :shortcut "F5" :command "wtype -M f5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Run Without Debugging" :shortcut "Ctrl+F5" :command "wtype -M ctrl f5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Stop Debugging" :shortcut "Shift+F5" :command "wtype -M shift f5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Restart Debugging" :shortcut "Ctrl+Shift+F5" :command "wtype -M ctrl shift f5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Run Without Debugging" :shortcut "Ctrl+F5" :command "wtype -M ctrl f5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Add Configuration..." :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Install Additional Debuggers..." :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-terminal []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "New Terminal" :shortcut "Ctrl+Shift+`" :command "wtype -M ctrl shift grave; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Split Terminal" :shortcut "Ctrl+Shift+5" :command "wtype -M ctrl shift 5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Run Active File" :shortcut "" :command "wtype -M ctrl f5; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Run Selected Text" :shortcut "" :command "wtype -M shift enter; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Show All Terminals" :shortcut "" :command "wtype -M ctrl shift grave; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Kill Terminal" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Configure Terminal Settings" :shortcut "" :command "wtype -M ctrl comma; ~/.config/eww/scripts/close_popups.sh")))

(defwidget vscode-ayuda []
  (box :orientation "vertical" :space-evenly false
    (archivo-item :title "Welcome" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Show All Commands" :shortcut "Ctrl+Shift+P" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Documentation" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Editor Playground" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-separator)
    (archivo-item :title "Keyboard Shortcuts Reference" :shortcut "Ctrl+K Ctrl+R" :command "wtype -M ctrl k; wtype -M ctrl r; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Video Tutorials" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "Tips and Tricks" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")
    (archivo-item :title "About" :shortcut "" :command "wtype -M ctrl shift p; ~/.config/eww/scripts/close_popups.sh")))
