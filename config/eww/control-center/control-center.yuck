;; ============================================================
;; MÓDULO: Control Center (Ventanas Independientes)
;; ============================================================

(defpoll datetime       :interval "60s" :initial " Lun 1 Ene "  "~/.config/eww/scripts/get_datetime.sh")
(defpoll wifi_status    :interval "5s"  :initial "Cargando..."  "~/.config/eww/scripts/get_wifi_status.sh")
(defpoll bt_status      :interval "5s"  :initial "Cargando..."  "~/.config/eww/scripts/get_bt_status.sh")
(defpoll dnd_status     :interval "5s"  :initial "Desactivado"  "~/.config/eww/scripts/get_dnd_status.sh")
(defpoll volume_raw     :interval "1s"  :initial "50" "~/.config/eww/scripts/get_volume_raw.sh")
(defpoll brightness_raw :interval "1s"  :initial "50" "~/.config/eww/scripts/get_brightness_raw.sh")
(defpoll media_json     :interval "2s"  :initial "{\"title\":\"\",\"artist\":\"\",\"playing\":false,\"art_path\":\"/home/duvan/.config/eww/wallpapers/images/wall1.png\"}"
"~/.config/eww/scripts/get_media_info.sh")

;; ------------------------------------------------------------
;; Fila de "volver" reutilizable para tus ventanas independientes
;; ------------------------------------------------------------
(defwidget back-row [target-window title]
  (box :orientation "horizontal" :space-evenly false :spacing 8 :class "cc-back-row"
    (button :onclick "eww close ${target-window} && eww open control-center" :class "cc-back-button"
      (label :style "font-size: 16px; color: #0a84ff;" :text "‹"))
    (label :style "font-size: 15px; font-weight: 600; color: #f5f5f7;" :halign "start" :hexpand true :text title)))

;; ------------------------------------------------------------
;; Vista principal (cuadrícula)
;; ------------------------------------------------------------
(defwidget main-view []
  (box :orientation "vertical" :space-evenly false :spacing 8 :class "control-center-box"
    
    (box :orientation "vertical" :space-evenly false :spacing 10
      (box :orientation "horizontal" :halign "center" :space-evenly false :class "cc-header-pill"
        (label :style "font-size: 12px; color: #ff9f0a; margin-right: 6px;" :text "")
        (label :style "font-size: 13px; font-weight: 600; color: #f5f5f7;" :text "System Settings"))
      (box :orientation "horizontal" :space-evenly true :class "cc-title-row"
        (label :style "font-size: 15px; font-weight: 600; color: #f5f5f7;" :halign "start" :text "Control Center")
        (label :style "font-size: 13px; color: #8e8e93;" :halign "end" :text datetime)))
    
    ;; FILA 1: Wi-Fi + Reproductor
    (box :orientation "horizontal" :space-evenly false :spacing 8
      (box :orientation "vertical" :space-evenly false :spacing 8 :width 176
        
        (button :onclick "eww close control-center && eww open wifi-menu" :height 84 :class "cc-card-wifi-active"
          (box :orientation "vertical" :space-evenly false :valign "start" :halign "start"
            (label :style "font-size: 20px; color: #ffffff;" :halign "start" :text "󰤨")
            (box :style "min-height:4px;")
            (label :style "font-size: 12px; font-weight: 600; color: #ffffff;" :halign "start" :text "Wi-Fi")
            (label :style "font-size: 10px; color: rgba(255,255,255,0.85);" :halign "start" :text wifi_status)))
        
        (box :orientation "horizontal" :space-evenly true :spacing 8
          (button :onclick "eww close control-center && eww open bluetooth-menu" :width 84 :height 84 :class "cc-card-standard"
            (label :style "font-size: 20px; color: #ffffff;" :text "󰂯"))
          (button :onclick "eww close control-center && eww open battery-menu" :width 84 :height 84 :class "cc-card-standard"
            (label :style "font-size: 20px; color: #30d158;" :text "󰁹"))))
      
      (box :orientation "vertical" :space-evenly false :hexpand true :class "cc-card-media"
        :visible {media_json.title != ""}
        (label :style "font-size: 13px; font-weight: 600; color: #ffffff;" :halign "center" :limit-width 30 :text {media_json.title})
        (label :style "font-size: 11px; color: #8e8e93;" :halign "center" :limit-width 30 :text {media_json.artist})
        (box :style "min-height: 4px;")
        (box :class "cc-media-art-frame" :halign "center"
          (image :class "cc-media-art" :path {media_json.art_path} :width 56 :height 56 :keep-ratio true))
        (box :style "min-height: 4px;")
        (box :orientation "horizontal" :space-evenly true :halign "center"
          (button :onclick "playerctl previous" :class "cc-media-control"
            (label :style "font-size: 16px; color: #ffffff;" :text "󰒮"))
          (button :onclick "~/.config/eww/scripts/toggle_media.sh" :class "cc-media-control"
            (label :style "font-size: 20px; color: #ffffff;" :text {media_json.playing ? "󰏤" : "󰐊"}))
          (button :onclick "playerctl next" :class "cc-media-control"
            (label :style "font-size: 16px; color: #ffffff;" :text "󰒭"))))
      (box :orientation "vertical" :hexpand true :halign "center" :valign "center" :class "cc-card-media"
        :visible {media_json.title == ""}
        (label :style "font-size: 24px; color: rgba(255,255,255,0.25);" :text "󰝚")))
    
    ;; FILA 2: Focus + 2 accesos
    (box :orientation "horizontal" :space-evenly false :spacing 8
      (button :onclick "~/.config/eww/scripts/toggle_dnd.sh" :width 176 :height 84 :class "cc-card-focus"
        (box :orientation "vertical" :space-evenly false :halign "start" :valign "start"
          (label :style "font-size: 18px; color: #ffffff;" :halign "start" :text "󰽪")
          (box :style "min-height:4px;")
          (label :style "font-size: 12px; font-weight: 600; color: #ffffff;" :halign "start" :text "No molestar")
          (label :style "font-size: 10px; color: rgba(255,255,255,0.85);" :halign "start" :text dnd_status)))
      (button :onclick "hyprctl dispatch exec hyprland-run" :width 84 :height 84 :class "cc-card-standard"
        (label :style "font-size: 18px; color: #ffffff;" :text "󰕮"))
      (button :onclick "hyprctl dispatch togglespecialworkspace 'name:minimized'" :width 84 :height 84 :class "cc-card-standard"
        (label :style "font-size: 18px; color: #ffffff;" :text "󰆟")))
    
    ;; SLIDERS
    (box :orientation "vertical" :space-evenly false :spacing 2 :class "cc-slider-box"
      (box :orientation "horizontal" :space-evenly false
        (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "󰃞")
        (scale :class "brightness-slider" :hexpand true :min 0 :max 101 :value brightness_raw :onchange "brightnessctl set {}%")
        (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "󰃟")))
    
    (box :orientation "horizontal" :space-evenly false :spacing 4 :class "cc-slider-box"
      (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "󰕿")
      (scale :class "volume-slider" :hexpand true :min 0 :max 101 :value volume_raw :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
      (button :onclick "eww close control-center && eww open audio-menu" :class "cc-media-control"
        (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "Audio")))
  
    ;; FILA FINAL: 4 accesos circulares (ahora correctamente dentro de main-view)
    (box :orientation "horizontal" :space-evenly true :spacing 8
      (button :onclick "gsettings set org.gnome.desktop.interface color-scheme prefer-dark" :width 78 :height 78 :class "cc-circle-btn"
        (label :style "font-size: 17px; color: #ffffff;" :text "󰗠"))
      (button :onclick "gnome-calculator" :width 78 :height 78 :class "cc-circle-btn"
        (label :style "font-size: 17px; color: #ffffff;" :text "󰃬"))
      (button :onclick "gnome-clocks" :width 78 :height 78 :class "cc-circle-btn"
        (label :style "font-size: 17px; color: #ffffff;" :text "󰅐"))
      (button :onclick "~/.config/eww/scripts/toggle_recording.sh" :width 78 :height 78 :class "cc-circle-btn"
        (label :style "font-size: 17px; color: #ffffff;" :text "󰄀")))
  )
)

;; ------------------------------------------------------------
;; Ventana única del Centro de Control Principal
;; ------------------------------------------------------------
(defwindow control-center
  :geometry (geometry :x "0%" :y "0%" :width "400px" :height "75%" :anchor "top right")
  :monitor 0
  :stacking "overlay"
  :windowtype "normal"
  :exclusive false
  :class "control-center"
  (main-view))