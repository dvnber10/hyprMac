;; ============================================================
;; MÓDULO: Bluetooth Menu (Estilo Panel Móvil con Batería y Señal)
;; ============================================================
(defpoll bt_devices :interval "5s" :initial "[]" "~/.config/eww/scripts/get_bt_devices.sh")

(defwidget bluetooth-list []
  (box :orientation "vertical" :space-evenly false :spacing 8 :class "control-center-box"
       
       ;; Cabecera con botón de retorno al control center principal
       (back-row :target-window "bluetooth-menu" :title "Bluetooth")

       ;; --- SECCIÓN TIPO MÓVIL (Interruptor Principal) ---
       (button :onclick "~/.config/eww/scripts/toggle_bluetooth.sh" 
               :class "cc-item-list-button"
               (box :orientation "horizontal" :space-evenly false :spacing 10
                    (label :style "font-size: 18px; color: #0a84ff;" :text "󰂯")
                    (box :orientation "vertical" :space-evenly false :halign "start" :hexpand true
                         (label :style "font-size: 13px; font-weight: 600; color: #ffffff;" :halign "start" :text "Bluetooth")
                         (label :style "font-size: 11px; color: #8e8e93;" :halign "start" :text bt_status))))

       ;; Botón rápido para abrir configuración avanzada de Bluetooth (p.ej. blueman-manager)
       (button :onclick "blueman-manager &" :class "cc-item-list-button"
               (box :orientation "horizontal" :space-evenly false
                    (label :style "font-size: 13px; color: #ffffff;" :halign "start" :hexpand true :text "Configuración avanzada")
                    (label :style "font-size: 13px; color: #8e8e93;" :text "󰒓")))

       ;; Título de dispositivos
       (label :style "font-size: 12px; color: #8e8e93; margin-top: 4px; margin-bottom: 2px;" :halign "start" :text "Dispositivos vinculados y cercanos")

       ;; Contenedor de dispositivos Bluetooth escaneados
       (box :orientation "vertical" :space-evenly false :spacing 4
            (for device in bt_devices
              (button :onclick {"~/.config/eww/scripts/connect_bluetooth.sh '" + device.mac + "'"}
                      :class "cc-item-list-button"
                      (box :orientation "horizontal" :space-evenly false :spacing 8
                           ;; Icono del dispositivo (o Bluetooth genérico)
                           (label :style "font-size: 14px; color: #ffffff;" :text "󰂯")
                           
                           ;; Nombre del dispositivo
                           (label :style "font-size: 12px; color: #f0f0f0;" :halign "start" :hexpand true :text {device.name})
                           
                           ;; Indicador opcional de batería
                           (label :style "font-size: 11px; color: #30d158; margin-right: 4px;" 
                                  :visible {device.battery != "" && device.battery != "N/A"} 
                                  :text {device.battery + "% "})

                           ;; Indicador opcional de intensidad de señal RSSI
                           (label :style "font-size: 11px; color: #8e8e93; margin-right: 4px;" 
                                  :visible {device.rssi != ""} 
                                  :text {device.rssi + "dBm"})

                           ;; Check de conectado
                           (label :style "font-size: 12px; color: #30d158;" :visible {device.connected} :text "󰄬")))))))

(defwindow bluetooth-menu
  :geometry (geometry :x "0%" :y "0%" :width "400px" :height "75%" :anchor "top right")
  :monitor 0
  :stacking "overlay"
  :windowtype "normal"
  :exclusive false
  :class "control-center"
  (bluetooth-list))