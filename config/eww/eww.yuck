;; ============================================================
;; ESTADO: qué vista mostrar dentro del mismo panel
;; ============================================================
(defvar cc_view "main")   ; "main" | "wifi" | "bluetooth"

;; ============================================================
;; DEFPOLLS
;; ============================================================
(defpoll datetime       :interval "60s" "~/.config/eww/scripts/get_datetime.sh")
(defpoll wifi_status    :interval "5s"  "~/.config/eww/scripts/get_wifi_status.sh")
(defpoll bt_status      :interval "5s"  "~/.config/eww/scripts/get_bt_status.sh")
(defpoll dnd_status     :interval "5s"  "~/.config/eww/scripts/get_dnd_status.sh")
(defpoll volume_raw     :interval "1s"  :initial "50" "~/.config/eww/scripts/get_volume_raw.sh")
(defpoll brightness_raw :interval "1s"  :initial "50" "~/.config/eww/scripts/get_brightness_raw.sh")
(defpoll media_json     :interval "2s"  :initial "{\"title\":\"\",\"artist\":\"\",\"playing\":false}"
                         "~/.config/eww/scripts/get_media_info.sh")

;; Solo escanean mientras la vista correspondiente está abierta
(defpoll wifi_networks :interval "4s" :run-while {cc_view == "wifi"}      :initial "[]" "~/.config/eww/scripts/scan_wifi.sh")
(defpoll bt_devices    :interval "4s" :run-while {cc_view == "bluetooth"} :initial "[]" "~/.config/eww/scripts/scan_bluetooth.sh")

;; ============================================================
;; FILA DE VOLVER (reutilizable en las dos vistas de escaneo)
;; ============================================================
(defwidget back-row [title]
  (box :orientation "horizontal" :space-evenly false :spacing 8
       :style "padding: 0 4px 8px 4px; border-bottom: 1px solid rgba(255,255,255,0.06);"
       (button :onclick "eww update cc_view=main"
               :style "background: transparent; border: none;"
               (label :style "font-size: 16px; color: #0a84ff;" :text "‹"))
       (label :style "font-size: 15px; font-weight: 600; color: #f5f5f7;" :halign "start" :hexpand true :text title)))

;; ============================================================
;; VISTA: LISTA DE REDES WI-FI
;; ============================================================
(defwidget wifi-list []
  (box :orientation "vertical" :space-evenly false :spacing 6

       (back-row :title "Wi-Fi")

       (button :onclick "~/.config/eww/scripts/toggle_wifi.sh"
               :style "background-color: rgba(255,255,255,0.06); border-radius: 14px; padding: 8px 12px;"
               (box :orientation "horizontal" :space-evenly false
                    (label :style "font-size: 13px; color: #ffffff;" :halign "start" :hexpand true :text "Wi-Fi")
                    (label :style "font-size: 12px; color: #8e8e93;" :text wifi_status)))

       (box :orientation "vertical" :space-evenly false :spacing 4
            (for network in wifi_networks
              (button :onclick {"~/.config/eww/scripts/connect_wifi_smart.sh '" + network.ssid + "' " + network.secured + " " + network.known}
                      :style "background-color: rgba(255,255,255,0.05); border-radius: 12px; padding: 8px 12px;"
                      (box :orientation "horizontal" :space-evenly false :spacing 8
                           (label :style "font-size: 13px; color: #ffffff;" :text {network.secured ? "󰌾" : "󰤨"})
                           (label :style "font-size: 12px; color: #f0f0f0;" :halign "start" :hexpand true :text {network.ssid})
                           (label :style "font-size: 12px; color: #30d158;" :visible {network.connected} :text "󰄬")))))))

;; ============================================================
;; VISTA: LISTA DE DISPOSITIVOS BLUETOOTH
;; ============================================================
(defwidget bluetooth-list []
  (box :orientation "vertical" :space-evenly false :spacing 6

       (back-row :title "Bluetooth")

       (button :onclick "~/.config/eww/scripts/toggle_bt.sh"
               :style "background-color: rgba(255,255,255,0.06); border-radius: 14px; padding: 8px 12px;"
               (box :orientation "horizontal" :space-evenly false
                    (label :style "font-size: 13px; color: #ffffff;" :halign "start" :hexpand true :text "Bluetooth")
                    (label :style "font-size: 12px; color: #8e8e93;" :text bt_status)))

       (box :orientation "vertical" :space-evenly false :spacing 4
            (for device in bt_devices
              (button :onclick {"~/.config/eww/scripts/connect_bluetooth.sh '" + device.mac + "'"}
                      :style "background-color: rgba(255,255,255,0.05); border-radius: 12px; padding: 8px 12px;"
                      (box :orientation "horizontal" :space-evenly false :spacing 8
                           (label :style "font-size: 13px; color: #ffffff;" :text "󰂯")
                           (label :style "font-size: 12px; color: #f0f0f0;" :halign "start" :hexpand true :text {device.name})
                           (label :style "font-size: 12px; color: #30d158;" :visible {device.connected} :text "󰄬")))))))

;; ============================================================
;; VISTA PRINCIPAL (la cuadrícula que ya teníamos)
;; ============================================================
(defwidget main-view []
  (box :orientation "vertical" :space-evenly false :spacing 8

       (box :orientation "vertical" :space-evenly false :spacing 10
            (box :orientation "horizontal" :halign "center" :space-evenly false
                 :style "background-color: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.10);
                         border-radius: 20px; padding: 4px 16px;"
                 (label :style "font-size: 12px; color: #ff9f0a; margin-right: 6px;" :text "")
                 (label :style "font-size: 13px; font-weight: 600; color: #f5f5f7;" :text "System Settings"))
            (box :orientation "horizontal" :space-evenly true
                 :style "padding: 0 4px 6px 4px; border-bottom: 1px solid rgba(255,255,255,0.06);"
                 (label :style "font-size: 15px; font-weight: 600; color: #f5f5f7;" :halign "start" :text "Control Center")
                 (label :style "font-size: 13px; color: #8e8e93;" :halign "end" :text datetime)))

       ;; FILA 1: Wi-Fi (abre la lista) + Reproductor
       (box :orientation "horizontal" :space-evenly false :spacing 8
            (box :orientation "vertical" :space-evenly false :spacing 8 :width 176

                 (button :onclick "eww update cc_view=wifi"
                         :height 84
                         :style "background: linear-gradient(160deg, #4facfe 0%, #007aff 100%); border-radius: 20px; padding: 10px 12px;"
                         (box :orientation "vertical" :space-evenly false :valign "start" :halign "start"
                              (label :style "font-size: 20px; color: #ffffff;" :halign "start" :text "󰤨")
                              (box :style "min-height:4px;")
                              (label :style "font-size: 12px; font-weight: 600; color: #ffffff;" :halign "start" :text "Wi-Fi")
                              (label :style "font-size: 10px; color: rgba(255,255,255,0.85);" :halign "start" :text wifi_status)))

                 (box :orientation "horizontal" :space-evenly true :spacing 8
                      (button :onclick "eww update cc_view=bluetooth"
                              :width 84 :height 84
                              :style "background-color: rgba(255,255,255,0.10); border-radius: 20px;"
                              (label :style "font-size: 20px; color: #ffffff;" :text "󰂯"))
                      (button :onclick "wdisplays"
                              :width 84 :height 84
                              :style "background-color: rgba(255,255,255,0.10); border-radius: 20px;"
                              (label :style "font-size: 20px; color: #ffffff;" :text "󰐹"))))

            (box :orientation "vertical" :space-evenly false :hexpand true
                 :visible {media_json.title != ""}
                 :style "background-color: #1c1c1e; border-radius: 20px; padding: 12px;"
                 (label :style "font-size: 13px; font-weight: 600; color: #ffffff;" :halign "start" :limit-width 22 :text {media_json.title})
                 (label :style "font-size: 11px; color: #8e8e93;" :halign "start" :limit-width 26 :text {media_json.artist})
                 (box :style "min-height: 10px; min-width: 4px;" :vexpand true)
                 (box :orientation "horizontal" :space-evenly true
                      (button :onclick "playerctl previous" :style "background: transparent; border: none;"
                              (label :style "font-size: 16px; color: #ffffff;" :text "󰒮"))
                      (button :onclick "~/.config/eww/scripts/toggle_media.sh" :style "background: transparent; border: none;"
                              (label :style "font-size: 20px; color: #ffffff;" :text {media_json.playing ? "󰏤" : "󰐊"}))
                      (button :onclick "playerctl next" :style "background: transparent; border: none;"
                              (label :style "font-size: 16px; color: #ffffff;" :text "󰒭"))))
            (box :orientation "vertical" :hexpand true :halign "center" :valign "center"
                 :visible {media_json.title == ""}
                 :style "background-color: #1c1c1e; border-radius: 20px; padding: 12px;"
                 (label :style "font-size: 24px; color: rgba(255,255,255,0.25);" :text "󰝚")))

       ;; FILA 2: Focus + 2 accesos
       (box :orientation "horizontal" :space-evenly false :spacing 8
            (button :onclick "~/.config/eww/scripts/toggle_dnd.sh"
                    :width 176 :height 84
                    :style "background-color: #2e5c52; border-radius: 20px; padding: 10px 12px;"
                    (box :orientation "vertical" :space-evenly false :halign "start" :valign "start"
                         (label :style "font-size: 18px; color: #ffffff;" :halign "start" :text "󰽪")
                         (box :style "min-height:4px;")
                         (label :style "font-size: 12px; font-weight: 600; color: #ffffff;" :halign "start" :text "Focus")
                         (label :style "font-size: 10px; color: rgba(255,255,255,0.85);" :halign "start" :text dnd_status)))
            (button :onclick "hyprctl dispatch exec 'hyprland-run'"
                    :width 84 :height 84
                    :style "background-color: rgba(255,255,255,0.10); border-radius: 20px;"
                    (label :style "font-size: 18px; color: #ffffff;" :text "󰕮"))
            (button :onclick "hyprctl dispatch togglespecialworkspace minimized"
                    :width 84 :height 84
                    :style "background-color: rgba(255,255,255,0.10); border-radius: 20px;"
                    (label :style "font-size: 18px; color: #ffffff;" :text "󰆟")))

       ;; SLIDERS
       (box :orientation "vertical" :space-evenly false :spacing 2
            :style "background-color: rgba(255,255,255,0.06); border-radius: 20px; padding: 8px 14px;"
            (box :orientation "horizontal" :space-evenly false
                 (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "󰃞")
                 (scale :class "brightness-slider" :hexpand true :min 0 :max 101 :value brightness_raw :onchange "brightnessctl set {}%")
                 (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "󰃟")))

       (box :orientation "horizontal" :space-evenly false :spacing 4
            :style "background-color: rgba(255,255,255,0.06); border-radius: 20px; padding: 8px 14px;"
            (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "󰕿")
            (scale :class "volume-slider" :hexpand true :min 0 :max 101 :value volume_raw :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
            (button :onclick "pavucontrol" :style "background: transparent; border: none;"
                    (label :style "font-size: 12px; color: rgba(255,255,255,0.6);" :text "")))

       ;; FILA FINAL: 4 accesos circulares
       (box :orientation "horizontal" :space-evenly true :spacing 8
            (button :onclick "gsettings set org.gnome.desktop.interface color-scheme prefer-dark"
                    :width 78 :height 78 :style "background-color: rgba(255,255,255,0.10); border-radius: 18px;"
                    (label :style "font-size: 17px; color: #ffffff;" :text "󰗠"))
            (button :onclick "gnome-calculator"
                    :width 78 :height 78 :style "background-color: rgba(255,255,255,0.10); border-radius: 18px;"
                    (label :style "font-size: 17px; color: #ffffff;" :text "󰃬"))
            (button :onclick "gnome-clocks"
                    :width 78 :height 78 :style "background-color: rgba(255,255,255,0.10); border-radius: 18px;"
                    (label :style "font-size: 17px; color: #ffffff;" :text "󰅐"))
            (button :onclick "~/.config/eww/scripts/toggle_recording.sh"
                    :width 78 :height 78 :style "background-color: rgba(255,255,255,0.10); border-radius: 18px;"
                    (label :style "font-size: 17px; color: #ffffff;" :text "󰄀")))

       (button :halign "center" :onclick "eww open --toggle control-center-edit"
               :style "background-color: rgba(255,255,255,0.10); border-radius: 16px; padding: 6px 18px; margin-top: 2px;"
               (label :style "font-size: 12px; font-weight: 600; color: #ffffff;" :text "Edit Controls"))))

;; ============================================================
;; CONTENEDOR: cambia de vista según cc_view
;; ============================================================
(defwidget center-widget []
  (box :orientation "vertical"
       :space-evenly false
       :style "background-color: rgba(28, 28, 30, 0.55);
               border-radius: 26px;
               border: 1px solid rgba(255, 255, 255, 0.10);
               padding: 14px;
               font-family: 'SF Pro Display', sans-serif;
               min-width: 360px;"

       ;; Centro principal
       (box :visible {cc_view == "main"}
            :hexpand false
            :vexpand false
            (main-view))

       ;; Vista Wi-Fi
       (box :visible {cc_view == "wifi"}
            :hexpand false
            :vexpand false
            (wifi-list))

       ;; Vista Bluetooth
       (box :visible {cc_view == "bluetooth"}
            :hexpand false
            :vexpand false
            (bluetooth-list))))

(defwindow control-center
  :geometry (geometry :x "0%" :y "0%" :width "400px" :height "75%" :anchor "top right")
  :monitor 0
  :stacking "overlay"
  :windowtype "normal"
  :exclusive false
  :class "control-center"
  (center-widget))


;; ============================================================
;; DEFPOLLS / ESTADOS PARA EL MENÚ DE APPLE
;; ============================================================
(defpoll os_uptime      :interval "60s"  "uptime -p | sed 's/up //'")
(defpoll kernel_version :interval "600s" "uname -r")

;; ============================================================
;; WIDGET: Contenido Completo del Apple Menu
;; ============================================================
(defwidget apple-menu-widget []
  (box :orientation "vertical" :space-evenly false :spacing 4
       :style "background-color: rgba(28, 28, 30, 0.88);
               border-radius: 14px;
               border: 1px solid rgba(255, 255, 255, 0.12);
               padding: 8px;
               font-family: 'SF Pro Display', sans-serif;
               min-width: 250px;"

       (box :orientation "vertical" :space-evenly false :spacing 2
            :style "padding: 6px 10px; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 4px;"
            (label :style "font-size: 13px; font-weight: 600; color: #f5f5f7;" :halign "start" :text "Arch Linux (Wayland)")
            (label :style "font-size: 11px; color: #8e8e93;" :halign "start" :text {"Kernel: " + kernel_version})
            (label :style "font-size: 11px; color: #8e8e93;" :halign "start" :text {"Activo: " + os_uptime}))

       ;; OJO: "text-align" no existe en GTK CSS -> se quitó. La
       ;; alineación se controla con :halign en el label de adentro,
       ;; que ya estaba puesto correctamente.
       (button :onclick "~/.config/eww/scripts/close_popups.sh & ~/.config/System_Info/run.sh"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Acerca de este equipo..."))

       (box :style "min-height: 1px; background-color: rgba(255,255,255,0.08); margin: 4px 0;")

       (button :onclick "~/.config/eww/scripts/close_popups.sh & ~/.config/eww/scripts/open_settings.sh"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Ajustes del Sistema..."))

       (button :onclick "~/.config/eww/scripts/close_popups.sh & ~/.config/eww/scripts/open_appstore.sh"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Actualización de Software..."))

       (box :style "min-height: 1px; background-color: rgba(255,255,255,0.08); margin: 4px 0;")

       (button :onclick "~/.config/eww/scripts/close_popups.sh & hyprctl dispatch killactive"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Forzar salida..."))

       (box :style "min-height: 1px; background-color: rgba(255,255,255,0.08); margin: 4px 0;")

       (button :onclick "~/.config/eww/scripts/close_popups.sh & loginctl lock-session"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Bloquear pantalla"))
       (button :onclick "~/.config/eww/scripts/close_popups.sh & systemctl suspend"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Reposo"))
       (button :onclick "~/.config/eww/scripts/close_popups.sh & systemctl reboot"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Reiniciar..."))
       (button :onclick "~/.config/eww/scripts/close_popups.sh && loginctl terminate-user $USER ; systemctl start sddm"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Cerrar sesión..."))
       (button :onclick "~/.config/eww/scripts/close_popups.sh & shutdown now"
               :style "background: transparent; border-radius: 8px; padding: 6px 10px;"
               (label :style "font-size: 13px; color: #f5f5f7;" :halign "start" :text "Apagar..."))
  )
)

;; ============================================================
;; VENTANA: Menú Flotante de Apple
;; ============================================================
(defwindow apple-menu
  :monitor 0
  :geometry (geometry :x "0.5%" :y "1%" :width "270px" :anchor "top left")
  :stacking "overlay"
  :focusable false
  :exclusive false
  (apple-menu-widget)
)

;; ============================================================
;; ESTADO: qué popup está abierto ahora mismo (para saber qué
;; cerrar cuando se hace click afuera)
;; ============================================================
(defvar popup_open "none")   ; "none" | "control-center" | "apple-menu"

;; ============================================================
;; VENTANA ATRAPA-CLICKS
;; Cubre toda la pantalla, transparente, y va en la capa "top"
;; (por debajo de "overlay", donde están tus popups). Cualquier
;; click que no caiga sobre el popup en sí, cae aquí y cierra todo.
;; ============================================================
(defwidget click-catcher-widget []
  (button :onclick "~/.config/eww/scripts/close_popups.sh &"
          :hexpand true
          :vexpand true
          :style "background-color: transparent; border: none;"
          (box :hexpand true :vexpand true)))

(defwindow click-catcher
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "foreground"
  :exclusive false
  :focusable false
  :class "click-catcher"
  (click-catcher-widget))